{% extends 'supervisor/base.html.twig' %}

{% block title %}Supervisor Dashboard{% endblock %}

{% block body %}
    <!-- Top Header -->
    <header class="dashboard-header">
        <div>
            <h1>Welcome, {{ app.user.name }}</h1>
            <p class="date-display" id="current-date">Loading date...</p>
        </div>
        <div class="admin-profile">
            <div class="avatar sup-avatar"></div>
            <span>{{ app.user.supervisor ? app.user.supervisor.hostelAssigned : '' }} Supervisor</span>
        </div>
    </header>

    <!-- Hostel Info Banner -->
    <div class="block-info-banner">
        <div class="block-info-item">
            <span class="block-info-label">Assigned Hostel</span>
            <span class="block-info-value">{{ app.user.supervisor ? app.user.supervisor.hostelAssigned : 'N/A' }}</span>
        </div>
        <div class="block-info-divider"></div>
        <div class="block-info-item">
            <span class="block-info-label">Total Students</span>
            <span class="block-info-value">{{ totalStudents }}</span>
        </div>
        <div class="block-info-divider"></div>
        <div class="block-info-item">
            <span class="block-info-label">Floor Range</span>
            <span class="block-info-value">1 – 5</span>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="dashboard-stats">
        <div class="stat-card danger">
            <div class="stat-title">Pending Complaints</div>
            <div class="stat-value">{{ pendingComplaints }}</div>
        </div>
        <div class="stat-card vacant">
            <div class="stat-title">In Progress</div>
            <div class="stat-value">{{ inProgressComplaints }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-title">Room Change Requests</div>
            <div class="stat-value" id="pending-rc-count">{{ pendingRoomChanges }}</div>
        </div>
        <div class="stat-card occupied">
            <div class="stat-title">Resolved This Month</div>
            <div class="stat-value">{{ resolvedThisMonth }}</div>
        </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="dashboard-grid sup-dash-grid">

        <!-- Pending Room Change Requests -->
        <div class="dashboard-box">
            <div class="box-header">
                <h3>Pending Room Change Requests</h3>
                <span class="badge-count" id="rc-badge">{{ pendingRequests|length }}</span>
            </div>
            <table class="data-table" id="room-change-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Current Room</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="rc-tbody">
                    {% for req in pendingRequests %}
                    <tr data-student="{{ req.student.user.name }}" 
                        data-room="{{ req.currentRoom.roomNumber }}" 
                        data-req-room="{{ req.requestedRoom.roomNumber }}" 
                        data-reason="{{ req.reason }}" 
                        data-date="{{ req.requestedAt|date('M j, Y') }}"
                        data-id="{{ req.id }}">
                        <td>{{ req.student.user.name }}</td>
                        <td>{{ req.currentRoom.roomNumber }}</td>
                        <td>{{ req.reason|slice(0, 35) }}{{ req.reason|length > 35 ? '...' : '' }}</td>
                        <td class="rc-status-cell"><span class="status pending">Pending</span></td>
                        <td>
                            <button class="btn-action approve" onclick="openRCModal(this)">View</button>
                        </td>
                    </tr>
                    {% endfor %}
                    <tr id="rc-empty-row" style="{% if pendingRequests is not empty %}display:none;{% endif %}">
                        <td colspan="5" style="text-align:center; padding:30px; color:#64748b;">
                            🎉 All caught up! No pending room change requests right now.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Complaint Summary -->
        <div class="dashboard-box">
            <div class="box-header">
                <h3>Recent Complaints</h3>
                <a href="{{ path('supervisor_complaints') }}" class="btn-link">View All</a>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Room</th>
                        <th>Student</th>
                        <th>Type</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for comp in recentComplaints %}
                    <tr>
                        <td>{{ comp.room ? comp.room.roomNumber : 'N/A' }}</td>
                        <td>{{ comp.student ? comp.student.user.name : 'N/A' }}</td>
                        <td><span class="type-badge {{ comp.category.value|lower }}">{{ comp.category.value }}</span></td>
                        <td><span class="status {{ comp.status|lower|replace({' ': '-'}) }}">{{ comp.status }}</span></td>
                    </tr>
                    {% endfor %}
                    {% if recentComplaints is empty %}
                    <tr>
                        <td colspan="4" style="text-align:center; padding:30px; color:#64748b;">No recent complaints found.</td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>

        <!-- Recent Announcements -->
        <div class="dashboard-box announcement-box">
            <div class="box-header">
                <h3>My Recent Announcements</h3>
                <a href="{{ path('supervisor_announcements') }}" class="btn-link">Post New</a>
            </div>
            <div class="announcement-list">
                {% for ann in recentAnnouncements %}
                <div class="announcement-item">
                    <div class="announcement-meta">
                        <span class="announcement-date">{{ ann.createdAt|date('M j, Y') }}</span>
                    </div>
                    <h4 class="announcement-title">{{ ann.title }}</h4>
                    <p class="announcement-body">{{ ann.body }}</p>
                </div>
                {% endfor %}
                {% if recentAnnouncements is empty %}
                <div style="text-align:center; padding:30px; color:#64748b;">No recent announcements found.</div>
                {% endif %}
            </div>
        </div>

    </div> <!-- End Dashboard Grid -->

    <!-- ── Room Change Detail Modal ── -->
    <div class="modal-overlay" id="rc-modal-overlay" onclick="closeRCModal(event)">
        <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="rc-modal-title">
            <div class="modal-header">
                <h3 id="rc-modal-title">Room Change Request</h3>
                <button class="modal-close-btn" onclick="closeRCModal()" aria-label="Close">×</button>
            </div>
            <div class="modal-body">
                <div class="modal-detail-grid">
                    <div class="modal-detail-item">
                        <span class="modal-detail-label">Student Name</span>
                        <span class="modal-detail-value" id="rc-m-student"></span>
                    </div>
                    <div class="modal-detail-item">
                        <span class="modal-detail-label">Date Submitted</span>
                        <span class="modal-detail-value" id="rc-m-date"></span>
                    </div>
                    <div class="modal-detail-item">
                        <span class="modal-detail-label">Current Room</span>
                        <span class="modal-detail-value" id="rc-m-room"></span>
                    </div>
                    <div class="modal-detail-item">
                        <span class="modal-detail-label">Requested Room</span>
                        <span class="modal-detail-value" id="rc-m-req-room"></span>
                    </div>
                    <div class="modal-detail-item" style="grid-column: 1 / -1;">
                        <span class="modal-detail-label">Reason</span>
                        <span class="modal-detail-value" id="rc-m-reason"></span>
                    </div>
                </div>
            </div>
            <div class="modal-action-bar">
                <form id="rc-reject-form" method="POST" action="" style="display:inline;">
                    <button type="submit" class="btn-action reject" onclick="return confirm('Reject this room change request?')">✗ Reject</button>
                </form>
                <form id="rc-approve-form" method="POST" action="" style="display:inline;">
                    <button type="submit" class="btn-action approve" onclick="return confirm('Approve room change request?')">✓ Approve</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div id="sup-toast" class="toast" style="display:none;"></div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Live date display
        const dateEl = document.getElementById('current-date');
        const now = new Date();
        dateEl.textContent = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        let activeRCRow = null;

        function openRCModal(btn) {
            activeRCRow = btn.closest('tr');
            const d = activeRCRow.dataset;
            document.getElementById('rc-m-student').textContent  = d.student;
            document.getElementById('rc-m-date').textContent     = d.date;
            document.getElementById('rc-m-room').textContent     = d.room;
            document.getElementById('rc-m-req-room').textContent = d.reqRoom;
            document.getElementById('rc-m-reason').textContent   = d.reason;
            
            document.getElementById('rc-reject-form').action = '/supervisor/room-changes/' + d.id + '/reject';
            document.getElementById('rc-approve-form').action = '/supervisor/room-changes/' + d.id + '/approve';

            document.getElementById('rc-modal-overlay').classList.add('active');
        }

        function closeRCModal(e) {
            if (e && e.target !== document.getElementById('rc-modal-overlay')) return;
            document.getElementById('rc-modal-overlay').classList.remove('active');
            activeRCRow = null;
        }

        function showToast(msg) {
            const t = document.getElementById('sup-toast');
            t.textContent = msg;
            t.style.display = 'block';
            setTimeout(() => t.style.display = 'none', 2500);
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-overlay.active').forEach(el => el.classList.remove('active'));
            }
        });
    </script>
{% endblock %}
