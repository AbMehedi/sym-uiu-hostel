{% extends 'base.html.twig' %}

{% block title %}UIU Hostel Management System{% endblock %}

{% block body %}
    <!-- Navigation Bar -->
    <nav class="navbar">
        <div class="logo">
            <h2>UIU <span>HMS</span></h2>
        </div>
        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#facilities">Facilities</a></li>
            <li><a href="#rooms">Room Types</a></li>
            <li><a href="#rules">Rules</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
        <div class="nav-buttons">
            <a href="{{ path('app_login') }}" class="btn btn-outline">Login</a>
            <a href="{{ path('app_register') }}" class="btn btn-primary">Apply Now</a>
        </div>
    </nav>

    <!-- Hero Section -->
    <header id="home" class="hero">
        <div class="hero-content">
            <h1>Welcome to Your New Home</h1>
            <p>Experience comfortable living with top-notch facilities. Apply for admission or log in to manage your hostel life.</p>
            <div class="hero-actions">
                <a href="{{ path('app_register') }}" class="btn btn-primary btn-large">Student Admission</a>
                <a href="#facilities" class="btn btn-outline btn-large">Explore Facilities</a>
            </div>
        </div>

        <div class="stats-container">
            <div class="stat-card">
                <h3>{{ totalRooms }}+</h3>
                <p>Total Rooms</p>
            </div>
            <div class="stat-card">
                <h3>{{ accommodatedCount }}+</h3>
                <p>Students</p>
            </div>
            <div class="stat-card">
                <h3>{{ resolutionRate }}%</h3>
                <p>Complaints Resolved</p>
            </div>
            <div class="stat-card">
                <h3>24/7</h3>
                <p>Security & Support</p>
            </div>
        </div>
    </header>

    <!-- Facilities Section -->
    <section id="facilities" class="section">
        <div class="container">
            <p class="section-title-1">Facilities</p>
            <h2 class="section-title-2">Everything for a <span style="color: #2563eb;">comfortable stay.</span></h2>
            <p class="section-subtitle">UIU Hostel offers all modern amenities to make your studies and daily life easier.</p>
            <div class="grid">
                <div class="card">
                    <h3>High-Speed WiFi</h3>
                    <p>1 Gbps fiber internet in all rooms and common areas</p>
                </div>
                <div class="card">
                    <h3>Air Conditioning</h3>
                    <p>Individual AC in premium rooms — control it yourself</p>
                </div>
                <div class="card">
                    <h3>24/7 Hot Water</h3>
                    <p>Geysers in all washrooms — hot water anytime</p>
                </div>
                <div class="card">
                    <h3>Gym</h3>
                    <p>Well-equipped fitness center with modern equipment</p>
                </div>
                <div class="card">
                    <h3>24/7 Security</h3>
                    <p>CCTV surveillance and round-the-clock security personnel.</p>
                </div>
                <div class="card">
                    <h3>Study Room</h3>
                    <p>Quiet, well-lit study space with Wi-Fi</p>
                </div>
                <div class="card">
                    <h3>Common Lounge</h3>
                    <p>Relaxation area with TV and entertainment</p>
                </div>
                <div class="card">
                    <h3>Maintenance Support</h3>
                    <p>Quick resolution for plumbing, electricity, and cleaning issues.</p>
                </div>
                <div class="card">
                    <h3>Cleaning Service</h3>
                    <p>Regular cleaning of rooms and common areas</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Room Types Section -->
    <section id="rooms" class="section bg-light">
        <div class="container">
            <p class="section-title-1">Rooms Types</p>
            <h2 class="section-title-2">Pick a room <span style="color: #2563eb;">that’s right for you</span></h2>
            <div class="grid">
                {% for rtype in roomTypes %}
                <div class="card room-card">
                    {% if rtype.photoPath %}
                        <img src="{{ asset(rtype.photoPath) }}" alt="{{ rtype.name }}" class="room-img" style="width: 100%; height: 200px; object-fit: cover;">
                    {% else %}
                        <div class="room-img placeholder-img" style="height: 200px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #1e293b, #0f172a); color: #64748b; font-weight: 600;">
                            {{ rtype.name }} Photo
                        </div>
                    {% endif %}
                    <div class="room-info">
                        <h3>{{ rtype.name }}</h3>
                        <ul class="feature-list">
                            {% for feature in rtype.features %}
                            <li>{{ feature }}</li>
                            {% endfor %}
                        </ul>
                        <span class="badge">{{ rtype.badge }}</span>
                        <h3 class="price">Tk. {{ rtype.price }}/month</h3>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Rules Section -->
    <section id="rules" class="section">
        <div class="container">
            <p class="section-title-1">Hostel Rules & Regulations</p>
            <h2 class="section-title-2">A Few Important <span style="color: #2563eb;">Rules To Follow</span></h2>
            <p class="section-subtitle">Following these rules is mandatory to maintain a peaceful and harmonious community.</p>
            <div class="rules-grid">
                {% for rule in rules %}
                <div class="rule-card">
                    <div class="rule-number">{{ loop.index }}</div>
                    <p>{{ rule }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="section contact-section">
        <div class="container">
            <div class="contact-header">
                <p class="section-title-1">Contact</p>
                <h2 class="section-title-2">Talk to Us</h2>
            </div>

            <div class="contact-grid">
                <div class="contact-card">
                    <p class="card-label">PHONE</p>
                    <h4 class="card-value">{{ contact.phone }}</h4>
                    <p class="card-subtext">Mon-Sat 8 AM – 6 PM</p>
                </div>

                <div class="contact-card">
                    <p class="card-label">EMAIL</p>
                    <h4 class="card-value">{{ contact.email }}</h4>
                    <p class="card-subtext">Reply within 24 hours</p>
                </div>

                <div class="contact-card">
                    <p class="card-label">ADDRESS</p>
                    <h4 class="card-value">{{ contact.address }}</h4>
                    <p class="card-subtext">UIU Hostel Premises</p>
                </div>
            </div>

            <div class="cta-banner">
                <h3>Want to Enrol?</h3>
                <p>Login to the portal now and book your preferred room.</p>
                <a href="{{ path('app_register') }}" class="btn btn-white">Apply Today</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container footer-content">
            <div class="footer-section">
                <h3>Contact Us</h3>
                <p>Email: {{ contact.email }}</p>
                <p>Phone: {{ contact.phone }}</p>
                <p>Address: {{ contact.address }}</p>
            </div>
            <div class="footer-section">
                <h3>Quick Links</h3>
                <ul>
                    <li><a href="{{ path('app_login') }}">Admin Login</a></li>
                    <li><a href="{{ path('app_login') }}">Supervisor Login</a></li>
                    <li><a href="{{ path('app_login') }}">Student Login</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 Hostel Management System. All rights reserved.</p>
        </div>
    </footer>
{% endblock %}
