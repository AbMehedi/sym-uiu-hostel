{% extends 'student/base.html.twig' %}

{% block title %}Student Dashboard{% endblock %}

{% block body %}
    <!-- Top Header -->
    <header class="dashboard-header">
        <div>
            <h1>Welcome, {{ app.user.name }}</h1>
            <p class="date-display" id="current-date">Loading date...</p>
        </div>
        <div class="admin-profile">
            <div class="avatar stu-avatar"></div>
            <span>Student — {{ room ? 'Room ' ~ room.roomNumber : 'No Room' }}</span>
        </div>
    </header>

    <!-- Room Info Banner / Application Review Banner -->
    {% if admissionStatus and admissionStatus.value == 'approved' %}
    <div class="block-info-banner room-info-banner">
        <div class="block-info-item">
            <span class="block-info-label">Room Number</span>
            <span class="block-info-value stu-value">{{ room ? room.roomNumber : 'N/A' }}</span>
        </div>
        <div class="block-info-divider"></div>
        <div class="block-info-item">
            <span class="block-info-label">Room Type</span>
            <span class="block-info-value stu-value">{{ room ? room.capacity ~ ' Sharing' : 'N/A' }}</span>
        </div>
        <div class="block-info-divider"></div>
        <div class="block-info-item">
            <span class="block-info-label">Hostel</span>
            <span class="block-info-value stu-value">{{ room ? room.hostel : 'N/A' }}</span>
        </div>
        <div class="block-info-divider"></div>
        <div class="block-info-item">
            <span class="block-info-label">Supervisor</span>
            <span class="block-info-value stu-value" style="font-size:1.1rem;">{{ supervisor ? supervisor.name : 'Not Assigned' }}</span>
        </div>
    </div>
    {% else %}
    <div style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 12px; padding: 25px; margin-bottom: 30px; text-align: left;">
        <h3 style="color: #f59e0b; margin-top: 0; margin-bottom: 10px; font-size: 1.2rem; display: flex; align-items: center; gap: 8px;">
            ⏳ Application Status: {{ admissionStatus ? admissionStatus.value|upper : 'PENDING' }}
        </h3>
        <p style="margin: 0; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
            {% if admissionStatus and admissionStatus.value == 'rejected' %}
                ❌ Your admission request has been rejected. Please contact the hostel administration for further information.
            {% else %}
                Your admission request is currently pending administrator review. Once approved, you will be assigned to a room and will gain full access to all features (My Room, Complaints, Room Change Requests, Announcements, and Messenger Chat).
            {% endif %}
        </p>
    </div>
    {% endif %}

    <!-- Stats Cards -->
    <div class="dashboard-stats">
        <div class="stat-card">
            <div class="stat-title">My Complaints</div>
            <div class="stat-value">{{ totalComplaints }}</div>
        </div>
        <div class="stat-card danger">
            <div class="stat-title">Pending</div>
            <div class="stat-value">{{ pendingComplaints }}</div>
        </div>
        <div class="stat-card vacant">
            <div class="stat-title">In Progress</div>
            <div class="stat-value">{{ inProgressComplaints }}</div>
        </div>
        <div class="stat-card occupied">
            <div class="stat-title">Resolved</div>
            <div class="stat-value">{{ resolvedComplaints }}</div>
        </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="dashboard-grid stu-dash-grid">

        <!-- Roommate Info Box -->
        <div class="dashboard-box">
            <div class="box-header">
                <h3>My Roommate{{ roommates|length != 1 ? 's' : '' }}</h3>
                {% if admissionStatus and admissionStatus.value == 'approved' %}
                    <a href="{{ path('student_chat') }}" class="btn-link">Chat →</a>
                {% endif %}
            </div>
            {% if roommates is empty %}
                <div style="text-align:center;padding:30px;color:#64748b;">
                    {% if admissionStatus and admissionStatus.value == 'approved' %}
                        🛏️ You have no roommates yet (single occupancy or room not assigned).
                    {% else %}
                        ⏳ Admission {{ admissionStatus ? admissionStatus.value : 'pending' }}. Room will be assigned after approval.
                    {% endif %}
                </div>
            {% else %}
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Avatar</th>
                            <th>Name</th>
                            <th>Student ID</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for roommate in roommates %}
                        <tr>
                            <td>
                                <div class="roommate-avatar" style="width:36px;height:36px;font-size:0.85rem;">
                                    {{ roommate.user.name|slice(0,2)|upper }}
                                </div>
                            </td>
                            <td style="color:white;font-weight:500;">{{ roommate.user.name }}</td>
                            <td>{{ roommate.studentNumber }}</td>
                            <td>
                                <button class="btn btn-outline btn-sm" onclick="openRoommateModal({{ roommate.id }})" style="padding: 4px 10px; font-size: 0.75rem;">📋 Details</button>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>

        <!-- My Recent Complaints -->
        <div class="dashboard-box">
            <div class="box-header">
                <h3>My Recent Complaints</h3>
                {% if admissionStatus and admissionStatus.value == 'approved' %}
                    <a href="{{ path('student_complaints') }}" class="btn-link">View All →</a>
                {% endif %}
            </div>
            {% if recentComplaints is empty %}
                <div style="text-align:center;padding:30px;color:#64748b;">No complaints submitted yet.</div>
            {% else %}
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for complaint in recentComplaints %}
                        {% set statusValue = complaint.status.value is defined ? complaint.status.value : complaint.status|lower %}
                        <tr>
                            <td>{{ complaint.subject }}</td>
                            <td><span class="type-badge {{ complaint.category.value }}">{{ complaint.category.value|capitalize }}</span></td>
                            <td>{{ complaint.createdAt|date('M j, Y') }}</td>
                            <td>
                                {% if statusValue == 'pending' %}
                                    <span class="status pending">Pending</span>
                                {% elseif statusValue == 'in_progress' %}
                                    <span class="status in-progress">In Progress</span>
                                {% else %}
                                    <span class="status resolved">Resolved</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>

        <!-- Latest Announcements (full-width) -->
        <div class="dashboard-box announcement-box stu-announcement-box">
            <div class="box-header">
                <h3 style="display:flex;align-items:center;gap:10px;">
                    Latest Announcements
                    {% if unreadAnnouncements > 0 %}
                        <span style="background:var(--danger-color);color:white;font-size:0.75rem;padding:2px 8px;border-radius:12px;font-weight:600;">{{ unreadAnnouncements }} New</span>
                    {% endif %}
                </h3>
                {% if admissionStatus and admissionStatus.value == 'approved' %}
                    <a href="{{ path('student_announcements') }}" class="btn-link">View All →</a>
                {% endif %}
            </div>
            <div class="announcement-list">
                {% for ann in recentAnnouncements %}
                <div class="announcement-item">
                    <div class="announcement-meta">
                        <span class="announcement-date">{{ ann.createdAt|date('M j, Y') }}</span>
                    </div>
                    <h4 class="announcement-title">{{ ann.title }}</h4>
                    <p class="announcement-body">{{ ann.body }}</p>
                </div>
                {% else %}
                <div style="text-align:center;padding:30px;color:#64748b;">No announcements yet.</div>
                {% endfor %}
            </div>
        </div>

    </div> <!-- End Dashboard Grid -->

    {# ── Roommate Detail Modals (data-driven) ── #}
    {% for roommate in roommates %}
    <div class="modal-overlay" id="roommate-modal-{{ roommate.id }}" onclick="closeRoommateModal(event, '{{ roommate.id }}')">
        <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="roommate-modal-title-{{ roommate.id }}">
            <div class="modal-header">
                <h3 id="roommate-modal-title-{{ roommate.id }}">Roommate Profile</h3>
                <button class="modal-close-btn" onclick="closeRoommateModal(null, '{{ roommate.id }}')" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body">
                <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px;">
                    <div class="roommate-avatar" style="width:60px;height:60px;font-size:1.4rem;">
                        {{ roommate.user.name|slice(0,2)|upper }}
                    </div>
                    <div>
                        <h4 style="margin:0 0 4px 0;font-size:1.1rem;color:white;">{{ roommate.user.name }}</h4>
                        <span style="font-size:0.85rem;color:#94a3b8;">Room {{ room ? room.roomNumber : 'N/A' }} · Hostel {{ room ? room.hostel : 'N/A' }}</span>
                    </div>
                </div>
                <div class="modal-detail-grid">
                    <div class="modal-detail-item">
                        <span class="modal-detail-label">Student ID</span>
                        <span class="modal-detail-value">{{ roommate.studentNumber }}</span>
                    </div>
                    <div class="modal-detail-item">
                        <span class="modal-detail-label">Phone</span>
                        <span class="modal-detail-value">{{ roommate.phone ?? '—' }}</span>
                    </div>
                    <div class="modal-detail-item">
                        <span class="modal-detail-label">Email</span>
                        <span class="modal-detail-value">{{ roommate.user.email }}</span>
                    </div>
                    <div class="modal-detail-item">
                        <span class="modal-detail-label">Emergency Contact</span>
                        <span class="modal-detail-value">{{ roommate.emergencyContact ?? '—' }}</span>
                    </div>
                    <div class="modal-detail-item">
                        <span class="modal-detail-label">Admission Date</span>
                        <span class="modal-detail-value">{{ roommate.admissionDate ? roommate.admissionDate|date('M Y') : '—' }}</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="{{ path('student_chat') }}?partner={{ roommate.user.id }}" class="btn btn-primary">💬 Message</a>
                <button type="button" class="btn" onclick="closeRoommateModal(null, '{{ roommate.id }}')">Close</button>
            </div>
        </div>
    </div>
    {% endfor %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Live date display
        const dateEl = document.getElementById('current-date');
        const now = new Date();
        dateEl.textContent = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        // Roommate modal — now per-roommate IDs
        function openRoommateModal(roommateId) {
            document.getElementById('roommate-modal-' + roommateId).classList.add('active');
        }
        function closeRoommateModal(e, roommateId) {
            const overlay = document.getElementById('roommate-modal-' + roommateId);
            if (e && e.target !== overlay) return;
            overlay.classList.remove('active');
        }



        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-overlay.active').forEach(el => el.classList.remove('active'));
            }
        });
    </script>
{% endblock %}
