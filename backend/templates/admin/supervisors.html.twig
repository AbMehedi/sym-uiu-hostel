{% extends 'admin/base.html.twig' %}

{% block title %}Supervisor Management{% endblock %}

{% block body %}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <!-- Top Header -->
    <header class="dashboard-header">
        <div>
            <h1>Supervisor Management</h1>
            <p class="date-display">Add and manage hostel supervisors. Multiple supervisors can share a hostel.</p>
        </div>
        <a href="{{ path('admin_tasks') }}" class="btn btn-outline" style="margin-right:10px;">📋 Manage All Tasks</a>
        <button class="btn btn-primary" onclick="document.getElementById('add-supervisor').scrollIntoView({behavior: 'smooth'})">
            + Add New Supervisor
        </button>
    </header>

    <!-- Current Supervisors Grid -->
    <div class="dashboard-box" style="margin-bottom: 40px; background: transparent; border: none; box-shadow: none; padding: 0;">
        <h3 style="margin-bottom: 20px;">Active Supervisors</h3>

        {% if supervisors is empty %}
            <div style="text-align:center; padding:60px 20px; color:#64748b;">
                <p style="font-size:1.1rem;">No supervisors yet. Use the form below to add one.</p>
            </div>
        {% else %}
            <div class="supervisor-grid">
                {% for supervisor in supervisors %}
                <div class="supervisor-card" id="sup-card-{{ supervisor.id }}">
                    <div class="supervisor-header">
                        <div class="supervisor-avatar" style="display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:bold;color:white;text-transform:uppercase;">
                            {{ supervisor.user.name|slice(0, 1) }}
                        </div>
                        <span class="badge" style="background-color: #dbeafe; color: #1d4ed8; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{ supervisor.hostelAssigned }}">
                            {{ supervisor.hostelAssigned ?? 'Unassigned' }}
                        </span>
                    </div>
                    <div class="supervisor-info">
                        <h4 style="color: white; font-size: 1.1rem; font-weight: 600; margin-bottom: 5px;">{{ supervisor.user.name }}</h4>
                        <p style="color: #cbd5e1; font-size: 0.9rem;">ID: SUP-{{ supervisor.id }}</p>
                        {% if supervisor.phone %}
                            <p style="color: #cbd5e1; font-size: 0.9rem;">📞 {{ supervisor.phone }}</p>
                        {% endif %}
                        {% if supervisor.gender %}
                            <p style="color: #cbd5e1; font-size: 0.9rem;">⚧ {{ supervisor.gender.value|capitalize }}</p>
                        {% endif %}
                        {% if supervisor.nidNumber %}
                            <p style="color: #cbd5e1; font-size: 0.9rem;">🪪 {{ supervisor.nidNumber }}</p>
                        {% endif %}
                        {% if supervisor.nidDocumentPath %}
                            <p style="color: #cbd5e1; font-size: 0.9rem;">
                                <a href="{{ supervisor.nidDocumentPath }}" target="_blank" rel="noopener" style="color:#93c5fd; text-decoration:underline;">View NID</a>
                            </p>
                        {% endif %}
                        {% set taskCount = supervisor.tasks|length %}
                        {% set pendingTasks = supervisor.tasks|filter(t => t.status.value != 'done')|length %}
                        <p style="color: #94a3b8; font-size: 0.85rem; margin-top:6px;">
                            📋 {{ taskCount }} task{{ taskCount != 1 ? 's' : '' }}
                            {% if pendingTasks > 0 %}<span style="color:#f59e0b;">({{ pendingTasks }} pending)</span>{% endif %}
                        </p>
                    </div>
                    <div class="supervisor-actions">
                        <a href="{{ path('admin_tasks') }}?supervisorId={{ supervisor.id }}"
                           class="btn-action approve" style="text-decoration:none; text-align:center; display:inline-block;">
                            📋 Assign Task
                        </a>
                        <form method="POST" action="{{ path('admin_supervisors_delete', {id: supervisor.id}) }}" style="display:inline;">
                            <button type="submit" class="btn-action reject"
                                    onclick="return confirm('Remove supervisor {{ supervisor.user.name|e('js') }}? This will permanently delete their account.')">Remove</button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <!-- Add New Supervisor Form -->
    <div id="add-supervisor" class="dashboard-box">
        <div class="box-header" style="border-bottom: 1px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 25px;">
            <h3>Add New Supervisor</h3>
            <p class="text-muted" style="font-size: 0.85rem; color: #64748b;">
                Register a new supervisor and assign them to a hostel. Multiple supervisors can share the same hostel.
            </p>
        </div>

        <form class="auth-form" action="{{ path('admin_supervisors_new') }}" method="POST" enctype="multipart/form-data">
            <div class="form-grid">
                <!-- Full Name -->
                <div class="form-group">
                    <label for="sup-name">Full Name <span style="color:#ef4444;">*</span></label>
                    <input type="text" id="sup-name" name="name" class="form-control" placeholder="e.g. Rafiqul Hasan" required>
                </div>

                <!-- Phone Number -->
                <div class="form-group">
                    <label for="sup-phone">Phone Number</label>
                    <input type="tel" id="sup-phone" name="phone" class="form-control" placeholder="01XXX XXXXXX">
                </div>

                <!-- Hostel — dropdown from DB -->
                <div class="form-group">
                    <label for="sup-hostel">Assign to Hostel <span style="color:#ef4444;">*</span></label>
                    {% if hostels is empty %}
                        <p style="color:#ef4444; font-size:0.85rem; padding:8px 0;">
                            ⚠️ No hostels found. Please seed the database first (<code>app:seed-db</code>).
                        </p>
                        <input type="text" id="sup-hostel" name="hostel" class="form-control" placeholder="Hostel name" required>
                    {% else %}
                        <select id="sup-hostel" name="hostel" class="form-control" required>
                            <option value="" disabled selected>Select a hostel…</option>
                            {% for hostel in hostels %}
                                <option value="{{ hostel }}">{{ hostel }}</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </div>

                <!-- NID -->
                <div class="form-group">
                    <label for="sup-nid">NID Number <span style="color:#ef4444;">*</span></label>
                    <input type="text" id="sup-nid" name="nidNumber" class="form-control" placeholder="e.g. 1234 5678 9012 3456" required>
                </div>

                <!-- Gender -->
                <div class="form-group">
                    <label for="sup-gender">Gender (optional)</label>
                    <select id="sup-gender" name="gender" class="form-control">
                        <option value="" selected>Prefer not to say</option>
                        <option value="male">Male</option>
                        <option value="female">Female</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <!-- Email -->
                <div class="form-group">
                    <label for="sup-email">Email Address <span style="color:#ef4444;">*</span></label>
                    <input type="email" id="sup-email" name="email" class="form-control" placeholder="supervisor@hostel.edu" required>
                </div>
            </div>

            <div class="form-grid" style="margin-top: 10px;">
                <div class="form-group">
                    <label for="sup-nid-doc">NID Document (optional)</label>
                    <input type="file" id="sup-nid-doc" name="nidDocument" class="form-control" accept="image/*,.pdf">
                </div>

                <div class="form-group">
                    <label for="sup-add-docs">Additional Documents (optional)</label>
                    <input type="file" id="sup-add-docs" name="additionalDocs[]" class="form-control" accept="image/*,.pdf" multiple>
                </div>
            </div>

            <!-- Submit -->
            <div style="margin-top: 25px; text-align: right;">
                <button type="submit" class="btn btn-primary">Create Supervisor Account</button>
            </div>
        </form>
    </div>

    <!-- Toast -->
    <div id="admin-toast" class="toast" style="display:none;"></div>
{% endblock %}
