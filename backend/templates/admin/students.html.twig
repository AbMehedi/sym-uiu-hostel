{% extends 'admin/base.html.twig' %}

{% block title %}Student Management{% endblock %}

{% block body %}

{#
  ── Dynamic CSS ──────────────────────────────────────────────────────
  Radios are INSIDE .css-interactive-wrapper so they are siblings of
  .dashboard-grid, enabling the CSS ~ sibling combinator to work.
#}
<style>
    /* ── Row selection & profile visibility ── */
    {% for student in students %}
    #student-{{ student.id }}:checked ~ .dashboard-grid .right-container #profile-{{ student.id }} {
        display: block;
    }
    #student-{{ student.id }}:checked ~ .dashboard-grid #label-{{ student.id }} {
        border-left: 4px solid var(--primary-color) !important;
    }
    #student-{{ student.id }}:checked ~ .dashboard-grid #label-{{ student.id }} .css-td {
        color: var(--primary-color);
    }
    {% endfor %}

    /* ── Status-based row styling (left border + tint) ── */
    .row-approved  { border-left: 4px solid #10b981; }
    .row-pending   { border-left: 4px solid #f59e0b; }
    .row-rejected  { border-left: 4px solid #ef4444; }

    .row-approved:hover  { background-color: rgba(16,  185, 129, 0.1) !important; }
    .row-pending:hover   { background-color: rgba(245, 158,  11, 0.1) !important; }
    .row-rejected:hover  { background-color: rgba(239,  68,  68, 0.1) !important; }

    /* Checked state tint per status */
    {% for student in students %}
    {% set sv = student.admissionStatus.value %}
    #student-{{ student.id }}:checked ~ .dashboard-grid #label-{{ student.id }} {
        background-color: rgba(
            {{ sv == 'approved' ? '16,185,129' : (sv == 'rejected' ? '239,68,68' : '245,158,11') }},
            0.12
        ) !important;
    }
    {% endfor %}

    /* ── Row status dot ── */
    .status-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
        flex-shrink: 0;
    }
    .dot-approved { background-color: #10b981; }
    .dot-pending  { background-color: #f59e0b; }
    .dot-rejected { background-color: #ef4444; }

    /* ── Supervisor badge ── */
    .supervisor-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(37,99,235,0.1);
        border: 1px solid rgba(37,99,235,0.3);
        border-radius: 8px;
        padding: 10px 16px;
        margin-bottom: 25px;
    }
    .supervisor-badge .sup-icon {
        width: 34px; height: 34px;
        border-radius: 50%;
        background: #10b981;
        color: white;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.85rem; flex-shrink: 0;
    }
    .supervisor-badge .sup-label { font-size: 0.75rem; color: #64748b; }
    .supervisor-badge .sup-name  { font-size: 0.95rem; color: white; font-weight: 600; }
    .supervisor-badge .sup-block { font-size: 0.8rem; color: var(--primary-color); }

    /* ── No-supervisor state ── */
    .no-supervisor {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(100,116,139,0.1);
        border: 1px solid rgba(100,116,139,0.2);
        border-radius: 8px; padding: 10px 16px; margin-bottom: 25px;
        color: #64748b; font-size: 0.9rem;
    }
</style>

{# ── Top Header ── #}
<header class="dashboard-header">
    <div>
        <h1>Student Management</h1>
        <p class="date-display">View and manage all registered student profiles.</p>
    </div>
    <div class="admin-profile">
        <div class="avatar">A</div>
        <span>Admin</span>
    </div>
</header>

{# ── Stats Row ── #}
{% set approvedCount  = students|filter(s => s.admissionStatus.value == 'approved')|length %}
{% set pendingCount   = students|filter(s => s.admissionStatus.value == 'pending')|length %}
{% set rejectedCount  = students|filter(s => s.admissionStatus.value == 'rejected')|length %}
<div class="dashboard-stats" style="grid-template-columns: repeat(4, 1fr); margin-bottom: 30px;">
    <div class="stat-card">
        <div class="stat-title">Total Students</div>
        <div class="stat-value">{{ students|length }}</div>
    </div>
    <div class="stat-card occupied">
        <div class="stat-title">✅ Approved</div>
        <div class="stat-value" style="color: #10b981;">{{ approvedCount }}</div>
    </div>
    <div class="stat-card vacant">
        <div class="stat-title">⏳ Pending</div>
        <div class="stat-value" style="color: #f59e0b;">{{ pendingCount }}</div>
    </div>
    <div class="stat-card danger">
        <div class="stat-title">❌ Rejected</div>
        <div class="stat-value" style="color: #ef4444;">{{ rejectedCount }}</div>
    </div>
</div>

{# ═══════════════════════════════════════════════════════════
   Master-Detail Wrapper — radios inside so they are
   siblings of .dashboard-grid (required for CSS ~ to work)
   ═══════════════════════════════════════════════════════════ #}
<div class="css-interactive-wrapper">

    {% for student in students %}
        <input type="radio" name="student-select"
               id="student-{{ student.id }}"
               class="hidden-radio"
               {{ loop.first ? 'checked' : '' }}>
    {% endfor %}

    <div class="dashboard-grid" style="grid-template-columns: 1fr 1.6fr; align-items: start;">

        {# ══ LEFT: Student List ══ #}
        <div class="dashboard-box" style="padding: 0; overflow: hidden;">
            <div class="box-header" style="padding: 20px 25px 15px;">
                <h3>All Students</h3>
                <span class="status resolved">{{ students|length }} Records</span>
            </div>

            {# Legend #}
            <div style="padding: 0 25px 12px; display: flex; gap: 14px; flex-wrap: wrap;">
                <span style="font-size: 0.78rem; color: #64748b; display: flex; align-items: center; gap: 4px;">
                    <span class="status-dot dot-approved"></span> Approved
                </span>
                <span style="font-size: 0.78rem; color: #64748b; display: flex; align-items: center; gap: 4px;">
                    <span class="status-dot dot-pending"></span> Pending
                </span>
                <span style="font-size: 0.78rem; color: #64748b; display: flex; align-items: center; gap: 4px;">
                    <span class="status-dot dot-rejected"></span> Rejected
                </span>
            </div>

            {# Search bar #}
            <div style="padding: 0 25px 15px;">
                <input type="text" id="student-search" class="form-control"
                       placeholder="🔍 Search by name or ID…"
                       style="padding: 8px 14px; font-size: 0.9rem;"
                       oninput="filterStudents(this.value)">
            </div>

            {# CSS Grid Table #}
            <div class="css-table" id="student-list-table">
                <div class="css-thead">
                    <div class="css-th">Student ID</div>
                    <div class="css-th">Full Name</div>
                    <div class="css-th">Status</div>
                </div>
                <div class="css-tbody">
                    {% for student in students %}
                        {% set sv = student.admissionStatus.value %}
                        {% set rowClass = sv == 'approved' ? 'row-approved' : (sv == 'rejected' ? 'row-rejected' : 'row-pending') %}
                        {% set dotClass = sv == 'approved' ? 'dot-approved' : (sv == 'rejected' ? 'dot-rejected' : 'dot-pending') %}
                        {% set badgeClass = sv == 'approved' ? 'resolved' : (sv == 'rejected' ? 'in-progress' : 'pending') %}
                        <label
                            for="student-{{ student.id }}"
                            class="css-tr clickable-row student-row {{ rowClass }}"
                            id="label-{{ student.id }}"
                            data-name="{{ student.user.name|lower }}"
                            data-id="{{ student.studentNumber|lower }}"
                        >
                            <div class="css-td" style="font-family: monospace; font-size: 0.82rem; color: #94a3b8;">
                                {{ student.studentNumber }}
                            </div>
                            <div class="css-td" style="display: flex; align-items: center; gap: 0;">
                                <span class="status-dot {{ dotClass }}"></span>
                                <strong style="font-size: 0.92rem;">{{ student.user.name }}</strong>
                            </div>
                            <div class="css-td">
                                <span class="status status-sm {{ badgeClass }}">
                                    {{ sv|capitalize }}
                                </span>
                            </div>
                        </label>
                    {% else %}
                        <div style="padding: 30px; text-align: center; color: #64748b;">
                            No students registered yet.
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div id="no-results-msg" style="display:none; padding: 16px 25px; color: #64748b; font-size: 0.9rem;">
                No students match your search.
            </div>
        </div>{# /left panel #}

        {# ══ RIGHT: Profile Detail ══ #}
        <div class="dashboard-box right-container" style="position: sticky; top: 20px; min-height: 440px;">
            <div class="box-header profile-section-header" style="margin-bottom: 25px;">
                <h3>Student Profile Details</h3>
            </div>

            {% if students is empty %}
                <div style="text-align:center; padding: 40px 20px; color: #64748b;">
                    <p>No students found in the database.</p>
                </div>
            {% endif %}

            {% for student in students %}
                {% set sv = student.admissionStatus.value %}
                {% set badgeClass = sv == 'approved' ? 'resolved' : (sv == 'rejected' ? 'in-progress' : 'pending') %}
                {% set heroColor  = sv == 'approved' ? '#10b981' : (sv == 'rejected' ? '#ef4444' : '#f59e0b') %}
                {% set initials   = student.user.name|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2) %}

                {# Resolve supervisor via block #}
                {% set supervisor = null %}
                {% if student.room is not null %}
                    {% set block = student.room.block %}
                    {% if supervisorsByBlock[block] is defined %}
                        {% set supervisor = supervisorsByBlock[block] %}
                    {% endif %}
                {% endif %}

                <div class="profile-view" id="profile-{{ student.id }}">

                    {# ── Hero ── #}
                    <div class="profile-hero">
                        <div class="profile-avatar-lg"
                             style="font-size: 1.5rem; flex-shrink: 0; background-color: {{ heroColor }};">
                            {{ initials }}
                        </div>
                        <div class="profile-title">
                            <h2>{{ student.user.name }}</h2>
                            <p>Student • ID: {{ student.studentNumber }}</p>
                            <span class="status {{ badgeClass }}" style="margin-top: 6px; display: inline-block;">
                                {% if sv == 'approved' %}✅{% elseif sv == 'rejected' %}❌{% else %}⏳{% endif %}
                                {{ sv|capitalize }}
                            </span>
                        </div>
                    </div>

                    {# ── Supervisor Badge ── #}
                    {% if supervisor is not null %}
                        <div class="supervisor-badge">
                            {% set supInitials = supervisor.user.name|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2) %}
                            <div class="sup-icon">{{ supInitials }}</div>
                            <div>
                                <div class="sup-label">Block Supervisor</div>
                                <div class="sup-name">{{ supervisor.user.name }}</div>
                                <div class="sup-block">
                                    Block {{ supervisor.blockAssigned }}
                                    {% if supervisor.phone %}• {{ supervisor.phone }}{% endif %}
                                </div>
                            </div>
                        </div>
                    {% elseif student.room is not null %}
                        <div class="no-supervisor">
                            <span>⚠️</span>
                            No supervisor assigned to Block {{ student.room.block }}
                        </div>
                    {% else %}
                        <div class="no-supervisor">
                            <span>🏠</span>
                            No room assigned — supervisor not determined yet
                        </div>
                    {% endif %}

                    {# ── Contact & Admission Info ── #}
                    <h4 class="profile-subheading">Contact &amp; Admission Info</h4>
                    <div class="profile-info-grid">
                        <div class="info-item">
                            <span>Email Address</span>
                            <strong>{{ student.user.email }}</strong>
                        </div>
                        <div class="info-item">
                            <span>Phone Number</span>
                            <strong>{{ student.phone ?? '—' }}</strong>
                        </div>
                        <div class="info-item">
                            <span>Emergency Contact</span>
                            <strong>{{ student.emergencyContact ?? '—' }}</strong>
                        </div>
                        <div class="info-item">
                            <span>Admission Date</span>
                            <strong>{{ student.admissionDate ? student.admissionDate|date('M d, Y') : '—' }}</strong>
                        </div>
                        <div class="info-item">
                            <span>Assigned Room</span>
                            <strong class="text-primary">
                                {{ student.room ? ('Room ' ~ student.room.roomNumber ~ ' · Block ' ~ student.room.block) : 'Not Assigned' }}
                            </strong>
                        </div>
                        <div class="info-item">
                            <span>Account Created</span>
                            <strong>{{ student.user.createdAt|date('M d, Y') }}</strong>
                        </div>
                    </div>

                    {# ── Activity Summary ── #}
                    <h4 class="profile-subheading">Activity Summary</h4>
                    <div class="profile-info-grid" style="grid-template-columns: repeat(3, 1fr);">
                        <div class="info-item" style="text-align: center;">
                            <span>Complaints</span>
                            <strong style="font-size: 1.6rem; display: block; margin-top: 4px;
                                color: {{ student.complaints|length > 0 ? '#ef4444' : '#10b981' }};">
                                {{ student.complaints|length }}
                            </strong>
                        </div>
                        <div class="info-item" style="text-align: center;">
                            <span>Room Requests</span>
                            <strong style="font-size: 1.6rem; color: #f59e0b; display: block; margin-top: 4px;">
                                {{ student.roomChangeRequests|length }}
                            </strong>
                        </div>
                        <div class="info-item" style="text-align: center;">
                            <span>Admissions</span>
                            <strong style="font-size: 1.6rem; color: var(--primary-color); display: block; margin-top: 4px;">
                                {{ student.admissionRequests|length }}
                            </strong>
                        </div>
                    </div>

                    {# ── Room Assignment History ── #}
                    {% if student.roomAssignments is not empty %}
                        <h4 class="profile-subheading">Room Assignment History</h4>
                        <div style="border: 1px solid #1f2937; border-radius: 8px; overflow: hidden; margin-bottom: 25px;">
                            {% for assignment in student.roomAssignments %}
                                <div style="display:flex; justify-content:space-between; align-items:center;
                                            padding: 10px 15px; border-bottom: 1px solid #1f2937; background: #0e121b;">
                                    <span style="color: #c0bfbf; font-size: 0.9rem;">
                                        Room <strong style="color:white;">{{ assignment.room.roomNumber }}</strong>
                                        &nbsp;—&nbsp;{{ assignment.assignedDate|date('M d, Y') }}
                                        {% if assignment.vacatedDate %}
                                            → {{ assignment.vacatedDate|date('M d, Y') }}
                                        {% endif %}
                                    </span>
                                    <span class="status status-sm {{ assignment.status.value == 'active' ? 'resolved' : 'in-progress' }}">
                                        {{ assignment.status.value|capitalize }}
                                    </span>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {# ── Footer Actions ── #}
                    <div class="profile-footer" style="gap: 10px; justify-content: flex-end;">
                        {% if student.room is null %}
                            <a href="{{ path('admin_room_assign') }}" class="btn btn-outline btn-sm">Assign Room</a>
                        {% else %}
                            <a href="{{ path('admin_room_assign') }}" class="btn btn-outline btn-sm">Change Room</a>
                        {% endif %}
                    </div>

                </div>{# /profile-view #}
            {% endfor %}

        </div>{# /right-container #}

    </div>{# /dashboard-grid #}
</div>{# /css-interactive-wrapper #}

{# ── Search filter ── #}
<script>
function filterStudents(q) {
    q = q.toLowerCase().trim();
    let found = 0;
    document.querySelectorAll('.student-row').forEach(row => {
        const match = !q || row.dataset.name.includes(q) || row.dataset.id.includes(q);
        row.style.display = match ? '' : 'none';
        if (match) found++;
    });
    document.getElementById('no-results-msg').style.display =
        (found === 0 && q !== '') ? 'block' : 'none';
}
</script>

{% endblock %}
