{% extends 'admin/base.html.twig' %}

{% block title %}Reports & Analytics{% endblock %}

{% block body %}
    <header class="dashboard-header">
        <div>
            <h1>Operations & Exports Center</h1>
            <p class="date-display">One place for room occupancy, complaint tracking, repair-cost statistics, and PDF exports.</p>
        </div>
    </header>

    <div class="dashboard-box" style="margin-bottom:16px;padding:12px 16px;border:1px solid rgba(59,130,246,.35);background:rgba(37,99,235,.12);">
        <strong style="color:#93c5fd;">Tracking only:</strong>
        <span style="color:#cbd5e1;">Supervisors handle complaint updates and repair-cost entry. Admin monitors and exports.</span>
    </div>

    <div class="dashboard-box" style="margin-bottom:16px;">
        <div class="box-header profile-section-header">
            <h3>PDF Exports</h3>
            <span class="text-muted">Generate required admin documents.</span>
        </div>
        <div class="document-grid">
            <div class="document-card report-card-lg">
                <div class="doc-info flex-grow">
                    <h4 class="report-title">Room Allocation PDF</h4>
                    <p class="text-muted report-desc">Current room assignments by hostel and room.</p>
                    <a href="{{ path('admin_pdf_room_allocation') }}" class="btn btn-outline btn-full">Export</a>
                </div>
            </div>
            <div class="document-card report-card-lg">
                <div class="doc-info flex-grow">
                    <h4 class="report-title">Monthly Complaint Logs</h4>
                    <p class="text-muted report-desc">Chronological complaint register with statuses and totals.</p>
                    <a href="{{ path('admin_pdf_complaint_log', {month: 'now'|date('Y-m')}) }}" class="btn btn-outline btn-full">Export</a>
                </div>
            </div>
            <div class="document-card report-card-lg">
                <div class="doc-info flex-grow">
                    <h4 class="report-title">Repair Cost Report</h4>
                    <p class="text-muted report-desc">Repair-cost details and supervisor/category statistics.</p>
                    <a href="{{ path('admin_pdf_repair_costs') }}" class="btn btn-outline btn-full">Export</a>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-box" id="complaint-tracker" style="margin-bottom:16px;">
        <div class="box-header profile-section-header">
            <h3>Complaint & Repair-Cost Tracker</h3>
            <span class="text-muted">Read-only view of supervisor-maintained complaint operations.</span>
        </div>

        <form method="GET" action="{{ path('admin_reports') }}" style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-bottom:14px;">
            <div style="display:flex;align-items:center;gap:8px;">
                <label style="color:#94a3b8;font-size:.85rem;white-space:nowrap;">Type:</label>
                <select name="type" class="form-control form-control-sm" style="min-width:130px;">
                    <option value="">All Types</option>
                    {% for cat in complaintCategories %}
                        <option value="{{ cat.value }}" {{ activeType == cat.value ? 'selected' : '' }}>{{ cat.value|capitalize }}</option>
                    {% endfor %}
                </select>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <label style="color:#94a3b8;font-size:.85rem;white-space:nowrap;">Status:</label>
                <select name="status" class="form-control form-control-sm" style="min-width:130px;">
                    <option value="">All Statuses</option>
                    <option value="pending" {{ activeStatus == 'pending' ? 'selected' : '' }}>Pending</option>
                    <option value="in_progress" {{ activeStatus == 'in_progress' ? 'selected' : '' }}>In Progress</option>
                    <option value="resolved" {{ activeStatus == 'resolved' ? 'selected' : '' }}>Resolved</option>
                </select>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <label style="color:#94a3b8;font-size:.85rem;white-space:nowrap;">From:</label>
                <input type="date" name="from" value="{{ activeFrom }}" class="form-control form-control-sm" style="min-width:130px;">
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <label style="color:#94a3b8;font-size:.85rem;white-space:nowrap;">To:</label>
                <input type="date" name="to" value="{{ activeTo }}" class="form-control form-control-sm" style="min-width:130px;">
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Filter</button>
            <a href="{{ path('admin_reports') }}#complaint-tracker" class="btn btn-outline btn-sm">Clear</a>
        </form>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Ticket</th>
                    <th>Date</th>
                    <th>Room</th>
                    <th>Student</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Supervisor</th>
                    <th style="text-align:right;">Repair Cost</th>
                </tr>
            </thead>
            <tbody>
                {% for complaint in complaints %}
                    <tr>
                        <td>#CMP-{{ complaint.id }}</td>
                        <td>{{ complaint.createdAt|date('d M Y') }}</td>
                        <td>{{ complaint.room ? complaint.room.roomNumber : '—' }}</td>
                        <td>{{ complaint.student ? complaint.student.user.name : '—' }}</td>
                        <td>{{ complaint.category.value|capitalize }}</td>
                        <td><span class="status {{ complaint.status|lower|replace({' ': '-'}) }} status-sm">{{ complaint.status }}</span></td>
                        <td>{{ complaint.effectiveSupervisor ? complaint.effectiveSupervisor.user.name : 'Unassigned' }}</td>
                        <td style="text-align:right;">৳ {{ complaint.cost|number_format(2) }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" style="text-align:center;padding:24px;color:#64748b;">No complaints match the selected filters.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="dashboard-box">
        <div class="box-header profile-section-header">
            <h3>Cost Details Report & Statistics</h3>
            <span class="text-muted">{{ monthLabel }} aggregated by complaint category.</span>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Complaint Category</th>
                    <th>Total Complaints</th>
                    <th>Resolved</th>
                    <th>Pending</th>
                    <th class="text-right">Total Cost (BDT)</th>
                </tr>
            </thead>
            <tbody>
                {% set hasData = false %}
                {% for key, stat in categoryStats %}
                    {% if stat.total > 0 %}
                        {% set hasData = true %}
                        <tr>
                            <td><strong>{{ stat.label }}</strong></td>
                            <td>{{ stat.total }}</td>
                            <td>{{ stat.resolved }}</td>
                            <td>
                                {% if stat.pending > 0 %}
                                    <span class="status pending status-sm">{{ stat.pending }}</span>
                                {% else %}
                                    <span class="status resolved status-sm">0</span>
                                {% endif %}
                            </td>
                            <td class="text-right cost-value">৳ {{ stat.cost|number_format(2, '.', ',') }}</td>
                        </tr>
                    {% endif %}
                {% endfor %}
                {% if not hasData %}
                    <tr>
                        <td colspan="5" style="text-align:center;padding:30px;color:#64748b;">
                            No complaint or cost data recorded yet.
                        </td>
                    </tr>
                {% endif %}
            </tbody>
            <tfoot>
                <tr class="total-row">
                    <td colspan="4" class="text-right total-label"><strong>Grand Total Repair Cost:</strong></td>
                    <td class="text-right total-amount"><strong>৳ {{ grandTotal|number_format(2, '.', ',') }}</strong></td>
                </tr>
            </tfoot>
        </table>

        <div class="profile-footer footer-spread">
            <p class="text-muted footer-note">Room availability, occupancy, complaints, and repair costs are centralized in this module.</p>
            <a href="{{ path('admin_pdf_repair_costs') }}" class="btn btn-outline">Export Cost PDF</a>
        </div>
    </div>
{% endblock %}
